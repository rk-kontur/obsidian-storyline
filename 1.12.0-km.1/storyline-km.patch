@@ -0,0 +1,95 @@
+name: Release km
+
+# Builds the plugin and publishes a GitHub release for BRAT
+# when a tag of the form 1.2.3-km.N is pushed.
+# The tag must match "version" in manifest.json.
+#
+# Can also be started manually (workflow_dispatch): the version is taken
+# from manifest.json and the tag is created on the selected branch.
+
+on:
+  push:
+    tags:
+      - "*-km.*"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  release:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-node@v5
+        with:
+          node-version: 20.19.1
+          cache: npm
+
+      - name: Resolve version
+        id: v
+        run: |
+          V=$(node -p "require('./manifest.json').version")
+          if [ "${GITHUB_EVENT_NAME}" = "push" ] && [ "$V" != "${GITHUB_REF_NAME}" ]; then
+            echo "Tag ${GITHUB_REF_NAME} does not match manifest.json ($V)"
+            exit 1
+          fi
+          case "$V" in
+            *-km.*) ;;
+            *) echo "Version $V has no -km.N suffix"; exit 1 ;;
+          esac
+          echo "version=$V" >> "$GITHUB_OUTPUT"
+
+      - run: npm ci
+      - run: npm run build
+
+      - name: Publish release assets
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          V: ${{ steps.v.outputs.version }}
+        run: |
+          if ! gh release view "$V" >/dev/null 2>&1; then
+            gh release create "$V" \
+              --target "${GITHUB_SHA}" \
+              --title "$V" \
+              --notes "Fork build of StoryLine (id storyline-km) for BRAT testing."
+          fi
+          gh release upload "$V" main.js manifest.json styles.css --clobber
+
+      - name: Source bundle (changes compared to upstream)
+        run: |
+          # All source files the fork adds or changes compared to main (= upstream),
+          # without build output, plus a patch with the full diff.
+          git fetch --no-tags origin main:refs/remotes/origin/main
+          EXCL=(':(exclude)main.js' ':(exclude)package-lock.json')
+          git diff --name-only --diff-filter=AMR origin/main...HEAD -- . "${EXCL[@]}" > changed-files.txt
+          cat changed-files.txt
+          zip -q storyline-km-source.zip -@ < changed-files.txt
+          zip -q storyline-km-source.zip changed-files.txt
+          git diff origin/main...HEAD -- . "${EXCL[@]}" > storyline-km.patch
+
+      - name: Release notes and attachments
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          V: ${{ steps.v.outputs.version }}
+        run: |
+          node .github/scripts/km-release-notes.js notes
+          gh release upload "$V" storyline-km-source.zip storyline-km.patch --clobber
+          # Release text comes from the matching CHANGELOG-km.md section, but ONLY for the
+          # current version, and never when the text was edited by hand on GitHub
+          # (screenshots, images, extra notes). Older releases are never touched.
+          f="notes/$V.md"
+          [ -e "$f" ] || { echo "No changelog section for $V"; exit 0; }
+          current=$(gh release view "$V" --json body -q .body)
+          placeholder="Fork build of StoryLine (id storyline-km) for BRAT testing."
+          if [ -z "$current" ] || [ "$current" = "$placeholder" ] || [ "$current" = "$(cat "$f")" ]; then
+            gh release edit "$V" --notes-file "$f"
+            echo "Notes set: $V"
+          elif printf '%s' "$current" | grep -q -E '!\[|<img|user-attachments'; then
+            echo "Notes of $V contain images edited on GitHub - left untouched"
+          else
+            echo "Notes of $V were edited on GitHub - left untouched"
+          fi
