new file mode 100644
index 0000000..b2a2cfe
--- /dev/null
+++ b/utils/volumeScope.ts
@@ -0,0 +1,104 @@
+// ═══════════════════════════════════════════════════════
+//  Shared volume scope (fork: storyline-km)
+// ═══════════════════════════════════════════════════════
+//
+// One "current volume" for all views: pick "Volume 2" in any toolbar and
+// Board, Corkboard, Plot Grid, Timeline, Subway, Manuscript and Navigator
+// all show only the acts of that volume. Stored per vault (local storage),
+// '' means "All volumes". Implemented as an act restriction merged into the
+// SceneFilter each view already passes to getFilteredScenes, so the query
+// service itself is unchanged.
+
+import type { App } from 'obsidian';
+import type SceneCardsPlugin from '../main';
+import type { Scene, SceneFilter } from '../models/Scene';
+import { getProjectVolumes, getVolumeForAct, type VolumeDef } from './volumes';
+
+const STORAGE_KEY = 'storyline-km:volumeScope';
+
+export function getVolumeScope(app: App): string {
+    const v: unknown = app.loadLocalStorage(STORAGE_KEY);
+    return typeof v === 'string' ? v : '';
+}
+
+export function setVolumeScope(plugin: SceneCardsPlugin, id: string): void {
+    plugin.app.saveLocalStorage(STORAGE_KEY, id);
+    plugin.refreshOpenViews();
+}
+
+/** The scoped volume, or undefined for "All volumes" / unknown id. */
+export function getScopedVolume(app: App, projectFilePath: string | undefined | null): VolumeDef | undefined {
+    const id = getVolumeScope(app);
+    if (!id) return undefined;
+    return getProjectVolumes(app, projectFilePath).find(v => v.id === id);
+}
+
+/**
+ * Merge the volume scope into a SceneFilter (intersection with an existing
+ * act filter). Returns the filter unchanged when no volume is scoped.
+ */
+export function scopeFilter<T extends SceneFilter | undefined>(
+    app: App,
+    projectFilePath: string | undefined | null,
+    filter: T,
+): T | SceneFilter {
+    const vol = getScopedVolume(app, projectFilePath);
+    if (!vol) return filter;
+    const volActs = vol.acts.map(String);
+    const base = filter?.act?.length ? filter.act.map(String).filter(a => volActs.includes(a)) : volActs;
+    // Empty intersection must match nothing, not everything
+    return { ...(filter ?? {}), act: base.length ? base : ['__none__'] };
+}
+
+/** True if the scene is inside the scoped volume (or no volume is scoped). */
+export function inVolumeScope(app: App, projectFilePath: string | undefined | null, scene: Scene): boolean {
+    const vol = getScopedVolume(app, projectFilePath);
+    if (!vol) return true;
+    return getVolumeForAct([vol], scene.act) !== undefined;
+}
+
+/** Restrict a list of act numbers to the scoped volume. */
+export function scopeActs(app: App, projectFilePath: string | undefined | null, acts: number[]): number[] {
+    const vol = getScopedVolume(app, projectFilePath);
+    return vol ? acts.filter(a => vol.acts.includes(a)) : acts;
+}
+
+/** Key fragment for view-level caches that must invalidate on scope change. */
+export function volumeScopeKey(app: App): string {
+    return `vol:${getVolumeScope(app)}`;
+}
+
+/**
+ * Toolbar dropdown "All volumes / Volume 1 / …". Rendered only when the
+ * project defines volumes. Changing it re-renders every open StoryLine view.
+ */
+export function renderVolumeScopeSelect(parent: HTMLElement, plugin: SceneCardsPlugin): void {
+    const volumes = getProjectVolumes(plugin.app, plugin.sceneManager?.activeProject?.filePath);
+    if (volumes.length === 0) return;
+    const select = parent.createEl('select', {
+        cls: 'dropdown sl-km-volume-scope',
+        attr: { 'aria-label': 'Volume' },
+    });
+    select.createEl('option', { text: 'All volumes', value: '' });
+    for (const v of volumes) select.createEl('option', { text: v.title, value: v.id });
+    const current = getVolumeScope(plugin.app);
+    select.value = volumes.some(v => v.id === current) ? current : '';
+    select.addEventListener('keydown', (e: KeyboardEvent) => e.stopPropagation());
+    select.addEventListener('change', () => setVolumeScope(plugin, select.value));
+}
+
+/** Short volume badge text, e.g. "V2" for the 2nd volume, from the title's number if present. */
+export function volumeBadgeText(volumes: VolumeDef[], vol: VolumeDef): string {
+    const num = vol.title.match(/(\d+)\s*$/)?.[1];
+    return num ? `V${num}` : `V${volumes.indexOf(vol) + 1}`;
+}
+
+/** Small "V2" badge in a scene card header (Kanban and Corkboard). No-op without volumes. */
+export function renderVolumeBadge(parent: HTMLElement, plugin: SceneCardsPlugin, scene: Scene): void {
+    if (scene.act === undefined) return;
+    const volumes = getProjectVolumes(plugin.app, plugin.sceneManager?.activeProject?.filePath);
+    if (volumes.length === 0) return;
+    const vol = getVolumeForAct(volumes, scene.act);
+    if (!vol) return;
+    parent.createSpan({ cls: 'sl-km-volume-badge', text: volumeBadgeText(volumes, vol), attr: { title: vol.title } });
+}
diff --git a/utils/volumeSetups.ts b/utils/volumeSetups.ts
new file mode 100644
index 0000000..8a64ca4
--- /dev/null
+++ b/utils/volumeSetups.ts
@@ -0,0 +1,78 @@
+// ═══════════════════════════════════════════════════════
+//  Open setups at the end of each volume (fork: storyline-km)
+// ═══════════════════════════════════════════════════════
+//
+// A setup is "open at the end of volume N" if the setup scene lies in
+// volume N or earlier and none of its payoffs lies in volume N or earlier.
+// Links are read from both directions (payoff_scenes on the setup,
+// setup_scenes on the payoff), matched by scene title like the Validator.
+
+import type { Scene } from '../models/Scene';
+import { getVolumeForAct, type VolumeDef } from './volumes';
+
+export interface OpenSetup {
+    setup: Scene;
+    /** Titles of payoffs with their volume title, or "missing". */
+    payoffs: { title: string; where: string }[];
+}
+
+export interface VolumeOpenSetups {
+    volume: VolumeDef;
+    open: OpenSetup[];
+}
+
+/** Normalise a link value: strips [[ ]], alias and .md. */
+function linkTitle(raw: string): string {
+    let t = String(raw).trim();
+    const m = t.match(/^\[\[(.*)\]\]$/);
+    if (m) t = m[1];
+    t = t.split('|')[0];
+    t = t.split('/').pop() || t;
+    return t.replace(/\.md$/i, '').trim();
+}
+
+export function computeOpenSetups(volumes: VolumeDef[], scenes: Scene[]): VolumeOpenSetups[] {
+    if (volumes.length === 0) return [];
+    const volIndex = new Map(volumes.map((v, i) => [v.id, i]));
+    const byTitle = new Map<string, Scene>();
+    for (const s of scenes) if (s.title) byTitle.set(s.title, s);
+
+    // setup filePath → set of payoff titles
+    const links = new Map<string, Set<string>>();
+    const add = (setup: Scene, payoffTitle: string) => {
+        if (!links.has(setup.filePath)) links.set(setup.filePath, new Set());
+        links.get(setup.filePath)!.add(payoffTitle);
+    };
+    for (const s of scenes) {
+        for (const p of s.payoff_scenes ?? []) add(s, linkTitle(p));
+        for (const st of s.setup_scenes ?? []) {
+            const setup = byTitle.get(linkTitle(st));
+            if (setup && s.title) add(setup, s.title);
+        }
+    }
+
+    const sceneByPath = new Map(scenes.map(s => [s.filePath, s]));
+    const idxOf = (s: Scene | undefined): number | undefined => {
+        if (!s) return undefined;
+        const v = getVolumeForAct(volumes, s.act);
+        return v ? volIndex.get(v.id) : undefined;
+    };
+
+    return volumes.map((volume, n) => {
+        const open: OpenSetup[] = [];
+        for (const [path, payoffTitles] of links) {
+            const setup = sceneByPath.get(path);
+            const si = idxOf(setup);
+            if (!setup || si === undefined || si > n) continue;
+            const payoffs = [...payoffTitles].map(title => {
+                const target = byTitle.get(title);
+                const ti = idxOf(target);
+                return { title, idx: ti, where: target ? (ti !== undefined ? volumes[ti].title : 'no volume') : 'missing' };
+            });
+            const resolved = payoffs.some(p => p.idx !== undefined && p.idx <= n);
+            if (!resolved) open.push({ setup, payoffs: payoffs.map(({ title, where }) => ({ title, where })) });
+        }
+        open.sort((a, b) => (Number(a.setup.act) || 0) - (Number(b.setup.act) || 0) || (a.setup.sequence ?? 0) - (b.setup.sequence ?? 0));
+        return { volume, open };
+    });
+}
diff --git a/utils/volumes.ts b/utils/volumes.ts
new file mode 100644
index 0000000..84bc478
--- /dev/null
+++ b/utils/volumes.ts
@@ -0,0 +1,192 @@
+// ═══════════════════════════════════════════════════════
+//  Volumes as act groups (fork: storyline-km)
+// ═══════════════════════════════════════════════════════
+//
+// A volume is NOT a new level above acts. It is a named group of acts,
+// defined optionally in the project file's frontmatter:
+//
+//   volumes:
+//     - id: b1
+//       title: "Volume 1"
+//       acts: [1, 2, 3, 4]        # or "1-4"
+//       wordGoal: 90000           # optional
+//       deadline: 2027-03-01      # optional
+//
+// Scenes, numbering, sorting and filenames are untouched; a scene's
+// volume is derived from its act. Without `volumes:` every helper here
+// returns "no volumes" and the plugin behaves exactly like upstream.
+
+import type { App } from 'obsidian';
+import { TFile } from 'obsidian';
+
+export interface VolumeDef {
+    id: string;
+    title: string;
+    acts: number[];
+    wordGoal?: number;
+    deadline?: string;
+}
+
+/** Parse `[1,2,3]`, `"1-4"`, `"1-4, 6"` or a single number into act numbers. */
+export function parseActList(raw: unknown): number[] {
+    const out: number[] = [];
+    const addToken = (token: string) => {
+        const t = token.trim();
+        if (!t) return;
+        const range = t.match(/^(\d+)\s*-\s*(\d+)$/);
+        if (range) {
+            const a = Number(range[1]);
+            const b = Number(range[2]);
+            for (let i = Math.min(a, b); i <= Math.max(a, b); i++) out.push(i);
+            return;
+        }
+        const n = Number(t);
+        if (Number.isFinite(n)) out.push(n);
+    };
+    if (Array.isArray(raw)) {
+        for (const item of raw) addToken(String(item));
+    } else if (typeof raw === 'number') {
+        out.push(raw);
+    } else if (typeof raw === 'string') {
+        raw.split(',').forEach(addToken);
+    }
+    return Array.from(new Set(out)).sort((a, b) => a - b);
+}
+
+/** Parse the raw `volumes:` frontmatter value. Invalid entries are skipped. */
+export function parseVolumes(raw: unknown): VolumeDef[] {
+    if (!Array.isArray(raw)) return [];
+    const volumes: VolumeDef[] = [];
+    raw.forEach((entry, idx) => {
+        if (!entry || typeof entry !== 'object') return;
+        const e = entry as Record<string, unknown>;
+        const acts = parseActList(e.acts);
+        if (acts.length === 0) return;
+        const title = typeof e.title === 'string' && e.title.trim() ? e.title.trim() : `Volume ${idx + 1}`;
+        const id = e.id !== undefined && String(e.id).trim() ? String(e.id).trim() : `v${idx + 1}`;
+        const goal = Number(e.wordGoal);
+        const deadline = e.deadline instanceof Date
+            ? e.deadline.toISOString().slice(0, 10)
+            : (e.deadline !== undefined && e.deadline !== null ? String(e.deadline) : undefined);
+        volumes.push({
+            id,
+            title,
+            acts,
+            wordGoal: Number.isFinite(goal) && goal > 0 ? goal : undefined,
+            deadline: deadline || undefined,
+        });
+    });
+    return volumes;
+}
+
+/** Read volumes from the project file of the active project (via metadata cache). */
+export function getProjectVolumes(app: App, projectFilePath: string | undefined | null): VolumeDef[] {
+    if (!projectFilePath) return [];
+    const file = app.vault.getAbstractFileByPath(projectFilePath);
+    if (!(file instanceof TFile)) return [];
+    const fm = app.metadataCache.getFileCache(file)?.frontmatter;
+    return parseVolumes(fm?.volumes);
+}
+
+/** Volume containing the given act, or undefined. */
+export function getVolumeForAct(volumes: VolumeDef[], act: number | string | undefined): VolumeDef | undefined {
+    if (act === undefined || act === null || volumes.length === 0) return undefined;
+    const n = Number(act);
+    if (!Number.isFinite(n)) return undefined;
+    return volumes.find(v => v.acts.includes(n));
+}
+
+/** Act numbers of a volume by id (empty if unknown). */
+export function getActsForVolume(volumes: VolumeDef[], id: string): number[] {
+    return volumes.find(v => v.id === id)?.acts ?? [];
+}
+
+/** Export range (field 'act') for one volume, undefined for '' / unknown id. */
+export function volumeExportRange(
+    volumes: VolumeDef[],
+    id: string,
+): { field: 'act'; sequenceRanges: Array<{ start: number; end: number }> } | undefined {
+    if (!id) return undefined;
+    const acts = getActsForVolume(volumes, id);
+    if (acts.length === 0) return undefined;
+    return { field: 'act', sequenceRanges: acts.map(a => ({ start: a, end: a })) };
+}
+
+/**
+ * Tracks the current volume while a view renders act dividers in order and
+ * emits a volume band whenever a new volume starts.
+ */
+export class VolumeDividerTracker {
+    private lastId: string | null = null;
+
+    constructor(private volumes: VolumeDef[]) {}
+
+    get active(): boolean {
+        return this.volumes.length > 0;
+    }
+
+    /** Returns the volume if `act` starts a new volume, else undefined. */
+    next(act: number | string | undefined): VolumeDef | undefined {
+        if (!this.active) return undefined;
+        const vol = getVolumeForAct(this.volumes, act);
+        if (!vol || vol.id === this.lastId) return undefined;
+        this.lastId = vol.id;
+        return vol;
+    }
+
+    /** Render an HTML volume band before the act divider if a new volume starts. */
+    renderBefore(parent: HTMLElement, act: number | string | undefined, gridColumn?: string): void {
+        const vol = this.next(act);
+        if (!vol) return;
+        const band = parent.createDiv('sl-km-volume-divider');
+        if (gridColumn) band.setCssStyles({ gridColumn });
+        band.createSpan({ cls: 'sl-km-volume-divider-label', text: vol.title });
+    }
+}
+
+/** SVG volume marker for the Subway map: solid line plus title above the act labels. */
+export function drawSubwayVolumeMarker(
+    svg: SVGSVGElement,
+    doc: Document,
+    opts: { x: number; labelX: number; labelY: number; y1: number; y2: number; title: string; drawLine: boolean },
+): void {
+    const svgNS = 'http://www.w3.org/2000/svg';
+    if (opts.drawLine) {
+        const line = doc.createElementNS(svgNS, 'line');
+        line.setAttribute('x1', String(opts.x));
+        line.setAttribute('y1', String(opts.y1));
+        line.setAttribute('x2', String(opts.x));
+        line.setAttribute('y2', String(opts.y2));
+        line.setAttribute('stroke', 'var(--text-muted)');
+        line.setAttribute('stroke-width', '4');
+        svg.appendChild(line);
+    }
+    const label = doc.createElementNS(svgNS, 'text');
+    label.setAttribute('x', String(opts.labelX));
+    label.setAttribute('y', String(opts.labelY));
+    label.setAttribute('text-anchor', 'start');
+    label.setAttribute('font-size', '13');
+    label.setAttribute('font-weight', '700');
+    label.setAttribute('fill', 'var(--text-accent)');
+    label.textContent = opts.title.toUpperCase();
+    svg.appendChild(label);
+}
+
+/**
+ * Kanban helper: a narrow vertical band with the volume title, inserted
+ * between act columns where a new volume starts.
+ */
+export function renderVolumeColumnDivider(parent: HTMLElement, vol: VolumeDef): void {
+    const band = parent.createDiv('sl-km-volume-column');
+    band.setAttribute('title', vol.title);
+    band.createSpan({ cls: 'sl-km-volume-column-label', text: vol.title });
+}
+
+/** Act number from a Kanban act column key ("Act 5", "Prologue", "Epilogue"). */
+export function actFromColumnKey(key: string): number | undefined {
+    const k = key.trim().toLowerCase();
+    if (k === 'prologue') return 0;
+    if (k === 'epilogue') return 99;
+    const m = k.match(/(\d+(?:\.\d+)?)/);
+    return m ? Number(m[1]) : undefined;
+}
